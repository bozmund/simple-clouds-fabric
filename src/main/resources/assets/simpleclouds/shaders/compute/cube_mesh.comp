layout(std430) readonly buffer NoiseLayers {
	NoiseLayer data[];
}
layers;

layout(std430) readonly buffer LayerGroupings {
	LayerGroup data[];
}
layerGroupings;

#if TYPE == 0
uniform sampler2DArray RegionsSampler;
uniform int RegionsTexSize;
#endif

uniform int LodLevel;
uniform int TotalLodLevels;
uniform ivec3 DispatchSize;
uniform vec3 RenderOffset;
// Instance positions are world blocks; noise/layer heights stay in cloud units.
uniform float WorldBaseY = 0.0;
uniform float Scale = 1.0;
uniform vec3 Scroll;
uniform float Wiggle;
uniform vec3 Origin;
uniform bool TestFacesFacingAway;
uniform int DoNotOccludeSide = -1;
uniform int ChunkIndex;

#if FIXED_SECTION_SIZE == 1
//Offset in number of mesh elements
uniform int OpaqueMeshDataOffset;
uniform int TransparentMeshDataOffset;
#endif

#if TRANSPARENCY == 1
uniform int TransparencyDistance = 300;
#endif

#if TYPE == 0
uniform vec2 RegionSampleOffset;
#elif TYPE == 1
uniform float FadeStart;
uniform float FadeEnd;
#endif

#if FADE_NEAR_ORIGIN == 1
uniform float FadeStart;
uniform float FadeEnd;
#endif

float getNoiseForLayer(NoiseLayer layer, float x, float y, float z, out vec3 gradient)
{
	if (y < layer.HeightOffset || y > layer.HeightOffset + layer.Height - 1)
		return -10000.0;
	vec3 scale = vec3(layer.ScaleX, layer.ScaleY, layer.ScaleZ);
	vec3 scrollScaled = Scroll / scale;
	vec3 samplePos = vec3(x, y, z) / scale + scrollScaled;
	float noise = psrdnoise(samplePos, TILE_PERIOD, Wiggle, gradient) * layer.ValueScale + layer.ValueOffset;
	float heightDelta = y - layer.HeightOffset;
	noise -= 1.0 - clamp(heightDelta / layer.FadeDistance, 0.0, 1.0);
	noise -= 1.0 - clamp((layer.Height - heightDelta) / layer.FadeDistance, 0.0, 1.0);
	return noise;
}

float getNoiseForLayerGroup(LayerGroup group, float x, float y, float z, out vec3 gradient)
{
	int totalLayers = group.EndIndex - group.StartIndex;
	if (totalLayers == 0)
	{
		return -10000.0;
	}
	else if (totalLayers == 1)
	{
		return getNoiseForLayer(layers.data[group.StartIndex], x, y, z, gradient);
	}
	else
	{
		vec3 finalGradient = vec3(0.0);
		float combinedNoise = 0.0;
		bool anyValid = false;
		for (int i = 0; i < totalLayers; i++)
		{
			vec3 gradForLayer = vec3(0.0);
			float valForLayer = getNoiseForLayer(layers.data[i + group.StartIndex], x, y, z, gradForLayer);
			if (valForLayer > -10.0)
			{
				combinedNoise += valForLayer;
				finalGradient += gradForLayer;
				anyValid = true;
			}
		}
		gradient = finalGradient;
		if (anyValid)
			return combinedNoise;
		else
			return -10000.0;
	}
	return 0.0;
}

bool isPosValid(float x, float y, float z, LayerGroup group, float fade)
{
#if TYPE == 0
	// Region chunks have a finite vertical band; the CPU generator emits its
	// top/bottom boundary faces instead of sampling an ungenerated neighbor.
	if (y < RenderOffset.y || y >= RenderOffset.y + DispatchSize.y * Scale)
		return false;
#endif
	vec3 gradient = vec3(0.0);
	return getNoiseForLayerGroup(group, x, y, z, gradient) + fade > 0.0;
}

bool isPosValid(float x, float y, float z, int nx, int nz, int owningRegionId)
{
#if TYPE == 0
	ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xz) + ivec2(RegionSampleOffset) + ivec2(nx, nz);
    vec4 info = texelFetch(RegionsSampler, ivec3(texelCoord, LodLevel), 0);
    if (info.r < 0.0) return false;
    // Adjacent formations are separate meshes even when both are opaque.
    if (info.r != float(owningRegionId)) return false;
    uint regionId = uint(info.r);
    LayerGroup group = layerGroupings.data[regionId];
    float fade = -5.0 * pow(1.0 - info.g, 10.0);
#if FADE_NEAR_ORIGIN == 1
    float len = distance(vec2(x, z), Origin.xz);
	fade = min(fade, -5.0 * (1.0 - min(max(len - FadeStart, 0.0) / (FadeEnd - FadeStart), 1.0)));
#endif
#elif TYPE == 1
	LayerGroup group = layerGroupings.data[0];
	float len = distance(vec2(x, z), Origin.xz);
	float fade = -5.0 * min(max(len - FadeStart, 0.0) / (FadeEnd - FadeStart), 1.0);
#endif
    return isPosValid(x, y, z, group, fade);
}

bool shouldNotOcclude(int index)
{
	if (DoNotOccludeSide != -1 && index == DoNotOccludeSide)
	{
		vec3 id = gl_GlobalInvocationID;
		vec3 size = gl_NumWorkGroups * LOCAL_SIZE;
		if (DoNotOccludeSide == 1)
			return id.x == size.x - 1.0;
		else if (DoNotOccludeSide == 0)
			return id.x == 0.0;
		else if (DoNotOccludeSide == 3)
			return id.y == size.y - 1.0;
		else if (DoNotOccludeSide == 2)
			return id.y == 0.0;
		else if (DoNotOccludeSide == 5)
			return id.z == size.z - 1.0;
		else if (DoNotOccludeSide == 4)
			return id.z == 0.0;
		else
			return false;
	}
	else
	{
		return false;
	}
}

// ----- Opaque -----

void createFace(vec3 center, float cubeRadius, int index, float brightness)
{
#if FIXED_SECTION_SIZE == 0
	atomicAdd(sidesPerChunk.data[ChunkIndex], 1u);
	uint currentFace = atomicAdd(totalSides, 1u);
#elif FIXED_SECTION_SIZE == 1
	uint currentFace = atomicAdd(sidesPerChunk.data[ChunkIndex], 1u);
#endif
	SideInfo side;
	side.side = float(index);
	// SPIKE (26.2): convert cloud units -> world blocks for the vertex format.
	side.x = center.x * CLOUD_SCALE;
	side.y = center.y * CLOUD_SCALE + WorldBaseY;
	side.z = center.z * CLOUD_SCALE;
	side.brightness = brightness;
	side.radius = cubeRadius * CLOUD_SCALE;
#if FIXED_SECTION_SIZE == 0
	sides.data[currentFace] = side;
#if FACE_IDS == 1
	uint voxel = (gl_GlobalInvocationID.z * uint(DispatchSize.y) + gl_GlobalInvocationID.y)
	    * uint(DispatchSize.x) + gl_GlobalInvocationID.x;
	faceIds.data[currentFace] = voxel * 6u + uint(index);
#endif
#elif FIXED_SECTION_SIZE == 1
	sides.data[OpaqueMeshDataOffset + currentFace] = side;
#if FACE_IDS == 1
	uint voxel = (gl_GlobalInvocationID.z * uint(DispatchSize.y) + gl_GlobalInvocationID.y)
	    * uint(DispatchSize.x) + gl_GlobalInvocationID.x;
	faceIds.data[OpaqueMeshDataOffset + currentFace] = voxel * 6u + uint(index);
#endif
#endif
}

void createCube(float x, float y, float z, float cubeRadius, float brightness, float fade, LayerGroup group, int regionId)
{
	vec3 pos = vec3(x, y, z);
	vec3 norm = normalize(pos - Origin);
	vec3 center = pos + cubeRadius;
	//-Y
	if ((TestFacesFacingAway || dot(norm, vec3(0.0, -1.0, 0.0)) <= 0.0) && (!isPosValid(x, y - Scale, z, group, fade) || shouldNotOcclude(2)))
		createFace(center, cubeRadius, 2, brightness);
	//+Y
	if ((TestFacesFacingAway || dot(norm, vec3(0.0, 1.0, 0.0)) <= 0.0) && (!isPosValid(x, y + Scale, z, group, fade) || shouldNotOcclude(3)))
		createFace(center, cubeRadius, 3, brightness);
	//-X
	if ((TestFacesFacingAway || dot(norm, vec3(-1.0, 0.0, 0.0)) <= 0.0) && (!isPosValid(x - Scale, y, z, -1, 0, regionId) || shouldNotOcclude(0)))
		createFace(center, cubeRadius, 0, brightness);
	//+X
	if ((TestFacesFacingAway || dot(norm, vec3(1.0, 0.0, 0.0)) <= 0.0) && (!isPosValid(x + Scale, y, z, 1, 0, regionId) || shouldNotOcclude(1)))
		createFace(center, cubeRadius, 1, brightness);
	//-Z
	if ((TestFacesFacingAway || dot(norm, vec3(0.0, 0.0, -1.0)) <= 0.0) && (!isPosValid(x, y, z - Scale, 0, -1, regionId) || shouldNotOcclude(4)))
		createFace(center, cubeRadius, 4, brightness);
	//+Z
	if ((TestFacesFacingAway || dot(norm, vec3(0.0, 0.0, 1.0)) <= 0.0) && (!isPosValid(x, y, z + Scale, 0, 1, regionId) || shouldNotOcclude(5)))
		createFace(center, cubeRadius, 5, brightness);
}

#if SHARED_OCCUPANCY == 1
shared uint workgroupOccupied[${LOCAL_SIZE_X} * ${LOCAL_SIZE_Y} * ${LOCAL_SIZE_Z}];
shared uint workgroupRegion[${LOCAL_SIZE_X} * ${LOCAL_SIZE_Y} * ${LOCAL_SIZE_Z}];

bool isNeighborValidShared(float x, float y, float z, ivec3 delta,
                           LayerGroup group, float fade, int owningRegionId)
{
    ivec3 localNeighbor = ivec3(gl_LocalInvocationID) + delta;
    ivec3 globalNeighbor = ivec3(gl_GlobalInvocationID) + delta;
    if (all(greaterThanEqual(localNeighbor, ivec3(0)))
            && all(lessThan(localNeighbor, LOCAL_SIZE_I))
            && all(greaterThanEqual(globalNeighbor, ivec3(0)))
            && all(lessThan(globalNeighbor, DispatchSize)))
    {
        uint index = uint((localNeighbor.z * LOCAL_SIZE_I.y + localNeighbor.y)
                * LOCAL_SIZE_I.x + localNeighbor.x);
        if (delta.y == 0 && workgroupRegion[index] != uint(owningRegionId + 1))
            return false;
        return workgroupOccupied[index] != 0u;
    }
    if (delta.y != 0)
        return isPosValid(x, y, z, group, fade);
    return isPosValid(x, y, z, delta.x, delta.z, owningRegionId);
}

void createCubeShared(float x, float y, float z, float cubeRadius,
                      float brightness, float fade, LayerGroup group, int regionId)
{
    vec3 pos = vec3(x, y, z);
    vec3 norm = normalize(pos - Origin);
    vec3 center = pos + cubeRadius;
    if ((TestFacesFacingAway || dot(norm, vec3(0.0, -1.0, 0.0)) <= 0.0)
            && (!isNeighborValidShared(x, y - Scale, z, ivec3(0, -1, 0), group, fade, regionId)
                || shouldNotOcclude(2)))
        createFace(center, cubeRadius, 2, brightness);
    if ((TestFacesFacingAway || dot(norm, vec3(0.0, 1.0, 0.0)) <= 0.0)
            && (!isNeighborValidShared(x, y + Scale, z, ivec3(0, 1, 0), group, fade, regionId)
                || shouldNotOcclude(3)))
        createFace(center, cubeRadius, 3, brightness);
    if ((TestFacesFacingAway || dot(norm, vec3(-1.0, 0.0, 0.0)) <= 0.0)
            && (!isNeighborValidShared(x - Scale, y, z, ivec3(-1, 0, 0), group, fade, regionId)
                || shouldNotOcclude(0)))
        createFace(center, cubeRadius, 0, brightness);
    if ((TestFacesFacingAway || dot(norm, vec3(1.0, 0.0, 0.0)) <= 0.0)
            && (!isNeighborValidShared(x + Scale, y, z, ivec3(1, 0, 0), group, fade, regionId)
                || shouldNotOcclude(1)))
        createFace(center, cubeRadius, 1, brightness);
    if ((TestFacesFacingAway || dot(norm, vec3(0.0, 0.0, -1.0)) <= 0.0)
            && (!isNeighborValidShared(x, y, z - Scale, ivec3(0, 0, -1), group, fade, regionId)
                || shouldNotOcclude(4)))
        createFace(center, cubeRadius, 4, brightness);
    if ((TestFacesFacingAway || dot(norm, vec3(0.0, 0.0, 1.0)) <= 0.0)
            && (!isNeighborValidShared(x, y, z + Scale, ivec3(0, 0, 1), group, fade, regionId)
                || shouldNotOcclude(5)))
        createFace(center, cubeRadius, 5, brightness);
}
#endif

// ----- Transparent -----

#if TRANSPARENCY == 1

void createTransparentCube(float x, float y, float z, float cubeRadius, float brightness, float alpha)
{
#if FIXED_SECTION_SIZE == 0
	atomicAdd(transparentCubesPerChunk.data[ChunkIndex], 1u);
	uint currentCube = atomicAdd(totalTransparentCubes, 1u);
#elif FIXED_SECTION_SIZE == 1
	uint currentCube = atomicAdd(transparentCubesPerChunk.data[ChunkIndex], 1u);
#endif
	TransparentCubeInfo cube;
	cube.x = x + cubeRadius;
	cube.y = y + cubeRadius;
	cube.z = z + cubeRadius;
	cube.brightness = brightness;
	cube.alpha = alpha;
	cube.radius = cubeRadius;
#if FIXED_SECTION_SIZE == 0
	cubesTransparent.data[currentCube] = cube;
#elif FIXED_SECTION_SIZE == 1
	cubesTransparent.data[TransparentMeshDataOffset + currentCube] = cube;
#endif
#if FACE_IDS == 1
	uint voxel = (gl_GlobalInvocationID.z * uint(DispatchSize.y) + gl_GlobalInvocationID.y)
		* uint(DispatchSize.x) + gl_GlobalInvocationID.x;
#if FIXED_SECTION_SIZE == 0
	transparentCubeIds.data[currentCube] = voxel;
#elif FIXED_SECTION_SIZE == 1
	transparentCubeIds.data[TransparentMeshDataOffset + currentCube] = voxel;
#endif
#endif
}

#endif

// -----------------------

#if SHARED_OCCUPANCY == 1
void main()
{
    bool inVolume = all(lessThan(gl_GlobalInvocationID, uvec3(DispatchSize)));
    vec3 id = gl_GlobalInvocationID;
    float x = id.x * Scale + RenderOffset.x;
    float y = id.y * Scale + RenderOffset.y;
    float z = id.z * Scale + RenderOffset.z;
    uint regionId = 0u;
    LayerGroup group = layerGroupings.data[0];
    float fade = 0.0;
    bool hasRegion = inVolume;

#if TYPE == 0
    if (inVolume)
    {
        ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xz) + ivec2(RegionSampleOffset);
        vec4 info = texelFetch(RegionsSampler, ivec3(texelCoord, LodLevel), 0);
        hasRegion = info.r >= 0.0;
        if (hasRegion)
        {
            regionId = uint(info.r);
            group = layerGroupings.data[regionId];
            fade = -5.0 * pow(1.0 - info.g, 10.0);
#if FADE_NEAR_ORIGIN == 1
            float len = distance(vec2(x, z), Origin.xz);
            fade = min(fade, -5.0 * (1.0 - min(max(len - FadeStart, 0.0) / (FadeEnd - FadeStart), 1.0)));
#endif
        }
    }
#elif TYPE == 1
    if (inVolume)
    {
        float len = distance(vec2(x, z), Origin.xz);
        fade = -5.0 * min(max(len - FadeStart, 0.0) / (FadeEnd - FadeStart), 1.0);
    }
#endif

    vec3 gradient = vec3(0.0);
    float noise = hasRegion ? getNoiseForLayerGroup(group, x, y, z, gradient) + fade : -10000.0;
    workgroupOccupied[gl_LocalInvocationIndex] = hasRegion && noise > 0.0 ? 1u : 0u;
    workgroupRegion[gl_LocalInvocationIndex] = hasRegion ? regionId + 1u : 0u;
    // Every invocation, including out-of-volume lanes, must reach this barrier.
    barrier();
    if (!hasRegion) return;

    float storminess = clamp(group.Storminess + fade * 0.1, 0.0, 1.0);
    float brightness = clamp(1.0 - storminess * (1.0 - clamp((y - group.StormStart) / group.StormFadeDistance, 0.0, 1.0)), 0.0, 1.0);
#if STYLE == 1
    gradient = normalize(gradient);
    float strength = dot(gradient, SHADE_DIRECTION) * 0.5 + 0.5;
    brightness = clamp(brightness - strength * 0.1, 0.0, 1.0);
#endif
    if (noise > 0.0)
    {
        createCubeShared(x, y, z, Scale / 2.0, brightness, fade, group, int(regionId));
    }
#if TRANSPARENCY == 1
    else if (group.TransparencyFade > 0.01 && noise > -group.TransparencyFade && noise < 0.0)
    {
        float length = distance(vec2(x, z), Origin.xz);
        if (length < TransparencyDistance)
        {
            float alpha = 1.0 / group.TransparencyFade * (noise + group.TransparencyFade);
            createTransparentCube(x, y, z, Scale / 2.0, brightness, alpha);
        }
    }
#endif
}
#else
void main()
{
    if (any(greaterThanEqual(gl_GlobalInvocationID, uvec3(DispatchSize)))) return;
    vec3 id = gl_GlobalInvocationID;
    float x = id.x * Scale + RenderOffset.x;
    float y = id.y * Scale + RenderOffset.y;
    float z = id.z * Scale + RenderOffset.z;

#if TYPE == 0
	ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xz) + ivec2(RegionSampleOffset);
    vec4 info = texelFetch(RegionsSampler, ivec3(texelCoord, LodLevel), 0);
    if (info.r < 0.0) return;
    uint regionId = uint(info.r);
    LayerGroup group = layerGroupings.data[regionId];
    float fade = -5.0 * pow(1.0 - info.g, 10.0);
#if FADE_NEAR_ORIGIN == 1
    float len = distance(vec2(x, z), Origin.xz);
	fade = min(fade, -5.0 * (1.0 - min(max(len - FadeStart, 0.0) / (FadeEnd - FadeStart), 1.0)));
#endif
#elif TYPE == 1
	LayerGroup group = layerGroupings.data[0];
	uint regionId = 0u;
	float len = distance(vec2(x, z), Origin.xz);
	float fade = -5.0 * min(max(len - FadeStart, 0.0) / (FadeEnd - FadeStart), 1.0);
#endif
	vec3 gradient = vec3(0.0);
	float noise = getNoiseForLayerGroup(group, x, y, z, gradient) + fade;
	float storminess = clamp(group.Storminess + fade * 0.1, 0.0, 1.0);
	float brightness = clamp(1.0 - storminess * (1.0 - clamp((y - group.StormStart) / group.StormFadeDistance, 0.0, 1.0)), 0.0, 1.0);
#if STYLE == 1
	gradient = normalize(gradient);
	float strength = dot(gradient, SHADE_DIRECTION) * 0.5 + 0.5;
	brightness = clamp(brightness - strength * 0.1, 0.0, 1.0);
#endif
    if (noise > 0.0)
    {
		createCube(x, y, z, Scale / 2.0, brightness, fade, group, int(regionId));
    }
#if TRANSPARENCY == 1
    else if (group.TransparencyFade > 0.01 && noise > -group.TransparencyFade && noise < 0.0)
    {
		float length = distance(vec2(x, z), Origin.xz);
		if (length < TransparencyDistance)
		{
			float alpha = 1.0 / group.TransparencyFade * (noise + group.TransparencyFade);
		createTransparentCube(x, y, z, Scale / 2.0, brightness, alpha);
		}
    }
#endif
}
#endif
