#version 430
layout(local_size_x = 256) in;

struct Cube {
    float x;
    float y;
    float z;
    float brightness;
    float alpha;
    float radius;
};
struct Face {
    float side;
    float x;
    float y;
    float z;
    float radius;
    float brightness;
    float alpha;
};
layout(std430, binding = 0) readonly buffer CompactCubes { Cube cubes[]; };
layout(std430, binding = 1) readonly buffer CompactIds { uint cubeIds[]; };
layout(std430, binding = 2) writeonly buffer ExpandedFaces { Face faces[]; };
layout(std430, binding = 3) writeonly buffer ExpandedIds { uint faceIds[]; };
layout(std430, binding = 4) buffer InvalidIds { uint invalidCount; };

uniform uint CubeCount;
uniform uint MaxCellId;
uniform float WorldBaseY;

void main() {
    uint at = gl_GlobalInvocationID.x;
    if (at >= CubeCount) return;
    Cube cube = cubes[at];
    uint cell = cubeIds[at];
    if (cell >= MaxCellId) {
        atomicAdd(invalidCount, 1u);
        return;
    }
    uint first = at * 6u;
    for (uint side = 0u; side < 6u; side++) {
        Face face;
        face.side = float(side);
        face.x = cube.x * 8.0;
        face.y = cube.y * 8.0 + WorldBaseY;
        face.z = cube.z * 8.0;
        face.radius = cube.radius * 8.0;
        face.brightness = cube.brightness;
        face.alpha = cube.alpha;
        faces[first + side] = face;
        faceIds[first + side] = cell * 6u + side;
    }
}
